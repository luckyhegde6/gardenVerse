{
  "name": "gardenverse",
  "version": "1.0.0",
  "private": true,
  "description": "Hybrid agriculture simulation ecosystem - virtual gardening, AI-powered agriculture assistant, IoT-enabled farming, geospatial community platform",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "mobile:dev": "npm run dev -w packages/mobile",
    "mobile:build": "npm run build -w packages/mobile",
    "admin:dev": "npm run dev -w packages/admin",
    "admin:build": "npm run build -w packages/admin",
    "vercel-build": "npm run prisma:generate -w packages/admin && npm run fetch-apk && npm run admin:build",
  "fetch-apk": "node scripts/fetch-apk.mjs",
    "ai:dev": "npm run dev -w services/ai",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "lint": "npm run lint -w packages/mobile",
    "typecheck": "npm run typecheck -w packages/mobile && npm run typecheck -w packages/admin",
    "typecheck:admin": "npm run typecheck -w packages/admin",
    "typecheck:mobile": "npm run typecheck -w packages/mobile",
    "test": "npm run test -w packages/admin",
    "test:admin": "npm run test -w packages/admin",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File e2e/scripts/run-e2e.ps1",
    "test:e2e:headed": "powershell -ExecutionPolicy Bypass -File e2e/scripts/run-e2e.ps1 -Headed",
    "test:e2e:docker-only": "docker compose -f e2e/docker/docker-compose.test.yml up -d",
    "test:feedback": "npx ts-node e2e/scripts/agentic-feedback.ts",
    "workflow:screenshots": "npx ts-node e2e/workflows/run-all-workflows.ts",
    "workflow:recordings": "npx ts-node e2e/workflows/record-demo.ts",
    "workflow:all": "powershell -ExecutionPolicy Bypass -File e2e/scripts/run-workflows.ps1 -All",
    "e2e:module": "npx ts-node e2e/modules/run-module.ts",
    "e2e:auth": "npx ts-node e2e/modules/run-module.ts auth --html",
    "e2e:garden": "npx ts-node e2e/modules/run-module.ts garden --html",
    "e2e:admin": "npx ts-node e2e/modules/run-module.ts admin --html",
    "e2e:weather": "npx ts-node e2e/modules/run-module.ts weather --html",
    "e2e:marketplace": "npx ts-node e2e/modules/run-module.ts marketplace --html",
    "e2e:community": "npx ts-node e2e/modules/run-module.ts community --html",
    "e2e:ai-scanner": "npx ts-node e2e/modules/run-module.ts ai-scanner --html",
    "e2e:invites": "npx ts-node e2e/modules/run-module.ts invites --html",
    "e2e:all": "npx ts-node e2e/modules/run-module.ts all --html",
    "docker:local": "docker compose -f docker-compose.local.yml up -d",
    "docker:local:down": "docker compose -f docker-compose.local.yml down",
    "deploy:test": "powershell -ExecutionPolicy Bypass -File scripts/vercel-deploy-test.ps1",
    "deploy:preview": "vercel deploy --prebuilt --yes",
    "deploy:prod": "vercel deploy --prod --prebuilt --yes",
    "prisma:generate": "npm run prisma:generate -w packages/admin",
    "prisma:migrate": "npm run prisma:migrate -w packages/admin",
    "prisma:seed": "npm run prisma:seed -w packages/admin",
    "prepare": "husky || true",
    "script:docker-local": "powershell -ExecutionPolicy Bypass -File scripts/docker-local.ps1",
    "script:docker-prod-debug": "powershell -ExecutionPolicy Bypass -File scripts/docker-prod-debug.ps1",
    "script:health-check": "powershell -ExecutionPolicy Bypass -File scripts/health-check.ps1",
    "script:db-diagnostic": "powershell -ExecutionPolicy Bypass -File scripts/db-diagnostic.ps1 -All",
    "script:reset-db": "powershell -ExecutionPolicy Bypass -File scripts/reset-db.ps1",
    "script:run-migrations": "powershell -ExecutionPolicy Bypass -File scripts/run-migrations.ps1",
    "script:stop-all": "powershell -ExecutionPolicy Bypass -File scripts/stop-all.ps1",
    "script:docker-cleanup": "powershell -ExecutionPolicy Bypass -File scripts/docker-cleanup.ps1",
    "test:e2e:mobile": "powershell -ExecutionPolicy Bypass -File e2e/mobile/run-mobile-e2e.ps1",
    "test:e2e:mobile:build": "powershell -ExecutionPolicy Bypass -File e2e/mobile/run-mobile-e2e.ps1 -Build",
    "test:e2e:integration": "npx playwright test --config=e2e/playwright.config.ts e2e/tests/integration.spec.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:integration"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "@react-native/js-polyfills": "^0.85.3",
    "@vercel/analytics": "^2.0.1",
    "metro": "^0.80.12",
    "metro-babel-transformer": "^0.80.12",
    "metro-cache": "^0.80.12",
    "metro-cache-key": "^0.80.12",
    "metro-config": "^0.80.12",
    "metro-core": "^0.80.12",
    "metro-file-map": "^0.80.12",
    "metro-minify-terser": "^0.80.12",
    "metro-resolver": "^0.80.12",
    "metro-runtime": "^0.80.12",
    "metro-source-map": "^0.80.12",
    "metro-symbolicate": "^0.80.12",
    "metro-transform-plugins": "^0.80.12",
    "metro-transform-worker": "^0.80.12",
    "playwright": "^1.60.0",
    "react-native-css-interop": "^0.2.4",
    "react-native-worklets": "^0.9.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "detox": "^20.51.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "prisma": "^7.8.0",
    "turbo": "^2.9.16",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "cross-spawn": ">=7.0.5",
    "axios": ">=1.7.0",
    "cookie": ">=0.7.0",
    "path-to-regexp": ">=0.1.12",
    "semver": ">=7.5.2",
    "tough-cookie": ">=4.1.3",
    "@types/react": "18.3.29"
  }
}
