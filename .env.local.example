# ============================================================================
# GardenVerse - Local Development Environment (.env.local)
# Copy to .env and fill in your API keys
# ============================================================================

# Application
NODE_ENV=development

# Database (Docker local)
DATABASE_URL=postgresql://gardenverse:gardenverse123@localhost:5432/gardenverse?schema=public
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-gardenverse-2026
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Weather API (optional - app works with simulated data if missing)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Google Maps (optional - geohash fallback)
GOOGLE_MAPS_API_KEY=

# AI Services
AI_SERVICE_URL=http://localhost:8000

# OpenFarm / Trefle (optional - local cache fallback)
TREFLE_API_KEY=
OPENFARM_API_URL=https://openfarm.cc/api/v1

# MQTT (optional - IoT features)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=gardenverse

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
SUPER_ADMIN_REGISTRATION_CODE=dev-admin-code-123

# Feature Flags
FEATURE_AI_DIAGNOSIS=true
FEATURE_MARKETPLACE=true
FEATURE_IOT_BETA=false
FEATURE_BLOCKCHAIN_BETA=false
FEATURE_REGIONAL_FEED=true

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Sentry (optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Verce; (optional for local dev)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
