# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI Model Settings
MODEL_CACHE_DIR=./models_cache
PLANTNET_MODEL_PATH=./models/plantnet_resnet50.pth
DISEASE_MODEL_PATH=./models/disease_efficientnet.pth
DEVICE=cpu

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=*

# Weather Service
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Environmental Constants
DEFAULT_TEMPERATURE_C=25
DEFAULT_HUMIDITY_PCT=60
DEFAULT_RAINFALL_MM=0
