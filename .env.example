# ============================================================================
# GardenVerse - Environment Configuration
# ============================================================================

# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://gardenverse:gardenverse123@localhost:5432/gardenverse
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Weather API
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Government Intelligence
GOVT_API_KEY=your-govt-api-key
GOVT_API_URL=https://api.data.gov.in

# AI Services
AI_SERVICE_URL=http://localhost:8000

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=gardenverse

# Blockchain (optional - phase 3)
BLOCKCHAIN_RPC_URL=http://localhost:8545
CONTRACT_TOKEN_ADDRESS=
CONTRACT_MARKETPLACE_ADDRESS=
CONTRACT_REPUTATION_ADDRESS=

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SUPER_ADMIN_REGISTRATION_CODE=change-this-to-a-secure-random-code

# Feature Flags
FEATURE_AI_DIAGNOSIS=true
FEATURE_MARKETPLACE=true
FEATURE_IOT_BETA=false
FEATURE_BLOCKCHAIN_BETA=false
FEATURE_REGIONAL_FEED=true

# Notifications (Firebase)
FCM_SERVER_KEY=your-fcm-server-key

# AWS (or any cloud provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=gardenverse-uploads

# Encryption
MESSAGING_ENCRYPTION_KEY=
QR_SIGNING_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Sentry
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Vercel
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id
