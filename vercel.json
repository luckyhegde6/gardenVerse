{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "contracts": false,
      "mobile": false,
      "services": false
    },
    "productionBranch": "main"
  },
  "installCommand": "npm install",
