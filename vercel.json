{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "contracts": false,
      "mobile": false,
      "services": false
    }
  },
  "installCommand": "npm install",
  "buildCommand": "npm run lint -w packages/admin && npm run prisma:generate -w packages/admin && npm run admin:build",
  "framework": "nextjs",
  "outputDirectory": "packages/admin/.next",
  "crons": []
}
