{
  "cleanupPeriodDays": 60,
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_AUTH_TOKEN": "${OPENROUTER_API_KEY}",
    "ANTHROPIC_API_KEY": "${OPENROUTER_API_KEY}",
    "ANTHROPIC_MODEL": "openrouter/owl-alpha"
  },
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(npx expo *)",
      "Bash(npx prisma *)",
      "Bash(npx tsc *)",
      "Bash(npx ts-node *)",
      "Bash(npx tsx *)",
      "Bash(git -C *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(format *)",
      "Bash(mkfs *)",
      "Bash(dd if=*)",
      "Bash(:(){:|:&};:)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(docker rm *)",
      "Bash(kubectl delete *)",
      "Bash(terraform destroy *)"
    ]
  },
  "defaultShell": "bash",
  "alwaysThinkingEnabled": false,
  "defaultMode": "acceptEdits",
  "autoCompactPercentageOverride": 75
}
