generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  REGIONAL_MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum InviteType {
  OPEN
  CODE
  QR
  LINK
  PASSCODE
}

enum TokenType {
  GREEN_CREDITS
  ECO_POINTS
  REPUTATION_TOKENS
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum GardenType {
  VIRTUAL
  REAL
  HYBRID
}

enum CropStatus {
  SEED
  SPROUTING
  GROWING
  MATURE
  HARVESTED
  WILTED
  DISEASED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  DISPUTED
}

enum SensorType {
  SOIL_MOISTURE
  HUMIDITY
  PH
  TEMPERATURE
  LIGHT
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

model User {
  id                      String                     @id @default(uuid()) @db.Uuid
  email                   String                     @unique
  phone                   String?
  username                String                     @unique
  displayName             String?
  passwordHash            String
  role                    UserRole                   @default(USER)
  isVerified              Boolean                    @default(false)
  isOnboarded             Boolean                    @default(false)
  isBlocked               Boolean                    @default(false)
  blockedAt               DateTime?
  blockedReason           String?
  avatarUrl               String?
  bio                     String?
  geohash                 String?
  region                  String?
  twoFactorEnabled        Boolean                    @default(false)
  telegramId              String?
  deviceTrustScore        Float                      @default(0.0)

  level                   Int                        @default(1)
  experience              Int                        @default(0)
  greenCredits            Float                      @default(0)
  ecoPoints               Float                      @default(0)
  reputationTokens        Float                      @default(0)
  sustainabilityScore     Float                      @default(0)
  trustScore              Float                      @default(100)
  marketplaceReliability  Float                      @default(100)
  communityStanding       Float                      @default(100)
  inviteCount             Int                        @default(0)

  currentStreak           Int                        @default(0)
  longestStreak           Int                        @default(0)
  lastActiveAt            DateTime?

  maxPlots                Int                        @default(1)
  plotPurchaseCount       Int                        @default(0)
  isRealGardener          Boolean                    @default(false)
  gardenerBadge           String?
  gardenerVerifiedAt      DateTime?

  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?

  gardens                 Garden[]                   @relation("UserGardens")
  crops                   Crop[]
  inventory               Inventory[]
  userPurchases           UserPurchase[]
  inventoryItems          UserInventory[]
  listings                MarketplaceListing[]
  purchases               MarketplaceTransaction[]   @relation("BuyerTransactions")
  sales                   MarketplaceTransaction[]   @relation("SellerTransactions")
  devices                 IotDevice[]
  notifications           Notification[]
  supportTickets          SupportTicket[]
  assignedTickets         SupportTicket[]            @relation("AssignedTickets")
  aiScans                 AiScan[]
  sentMessages            Message[]                  @relation("SentMessages")
  receivedMessages        Message[]                  @relation("ReceivedMessages")
  groups                  GroupMember[]
  invitesCreated          Invite[]                   @relation("CreatedInvites")
  invitesRedeemed         Invite[]                   @relation("RedeemedInvites")
  moderationReports       ModerationReport[]         @relation("ReportedReports")
  moderationActions       ModerationReport[]         @relation("ActionedReports")
  transactions            BlockchainTransaction[]
  reputationLogs          ReputationLog[]
  sensorReadings          SensorReading[]
  featureOverrides        UserFeatureOverride[]
  qrSessionsCreated       QrSession[]                @relation("CreatedQrSessions")
  qrSessionsUsed          QrSession[]                @relation("UsedQrSessions")
  auditLogs               AuditLog[]
  userEnergy              UserEnergy?
  dailyRewards            DailyReward[]
  plantCollections        PlantCollection[]
  speciesMasteries        SpeciesMastery[]

  plantHybridsCreated     PlantHybrid[]                @relation("HybridDiscoverer")
  userAchievements        UserAchievement[]
  sessions                Session[]
  tokenTransactions       TokenTransaction[]
  appLogs                 AppLog[]
  userQuests              UserQuest[]
  friends                 Friend[]                   @relation("UserFriends")
  friendOf                Friend[]                   @relation("FriendOf")
  sentFriendRequests      FriendRequest[]            @relation("SentRequests")
  receivedFriendRequests  FriendRequest[]            @relation("ReceivedRequests")
  gardenVisits            GardenVisit[]               @relation("VisitsMade")
  sentGifts               Gift[]                     @relation("GiftsSent")
  receivedGifts           Gift[]                     @relation("GiftsReceived")
  streakShields           StreakShield[]
  notificationPreferences NotificationPreferences?
  eventProgress           UserEventProgress[]
  breedingLabs            BreedingLab[]
  diseaseCases            DiseaseCase[]
  gardenDecorations       UserGardenDecoration[]
  referralMade            Referral[]                 @relation("ReferralsMade")
  referralReceived        Referral?                  @relation("ReferralReceived")

  plotPurchases           PlotPurchase[]
  soilChecks              SoilCheck[]

  @@index([email])
  @@index([username])
  @@index([geohash])
  @@index([region])
  @@index([sustainabilityScore])
  @@index([trustScore])
}

model PlantSpecies {
  id                String   @id @default(uuid()) @db.Uuid
  commonName        String
  scientificName    String   @unique
  family            String?
  genus             String?
  species           String?

  imageUrl          String?
  description       String?
  growingDays       Int?
  difficulty        String   @default("MEDIUM")
  minTemp           Float?
  maxTemp           Float?
  waterNeeds        String   @default("MODERATE")
  sunlightNeeds     String   @default("FULL_SUN")
  soilPhMin        Float?
  soilPhMax        Float?
  matureHeightCm    Float?
  spacingCm         Float?

  seasons           String[]
  edible            Boolean  @default(false)
  medicinal         Boolean  @default(false)
  attractsPollinators Boolean @default(false)
  isNative          Boolean  @default(false)
  tags              String[]

  companionSpeciesIds String[]
  isHybrid          Boolean  @default(false)
  hybridRecipe      Json?
  baseYield         Int      @default(1)
  tokensPerHarvest  Int      @default(10)
  growthTimeHours   Int?

  cropVarieties     CropVariety[]
  crops             Crop[]
  gardenPlanPlants  GardenPlanPlant[]
  collections       PlantCollection[]
  masteries         SpeciesMastery[]
  hybridsAsParent1  PlantHybrid[]                    @relation("HybridParent1")
  hybridsAsParent2  PlantHybrid[]                    @relation("HybridParent2")
  hybridResults     PlantHybrid[]                    @relation("HybridResult")
  breedingLabParent1 BreedingLab[]                   @relation("BreedParent1")
  breedingLabParent2 BreedingLab[]                   @relation("BreedParent2")
  breedingResults    BreedingLab[]                   @relation("BreedResult")

  dataSource        String   @default("openfarm")
  externalId        String?
  metadata          Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([commonName])
  @@index([scientificName])
  @@index([family])
  @@index([seasons])
  @@index([difficulty])
  @@index([dataSource])
}

model CropVariety {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  daysToMaturity Int?
  characteristics Json?

  speciesId   String   @db.Uuid
  species     PlantSpecies @relation(fields: [speciesId], references: [id])
  crops       Crop[]

  createdAt   DateTime @default(now())

  @@index([speciesId])
}

model GardenPlan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  difficulty  String   @default("MEDIUM")
  gridWidth   Int      @default(4)
  gridHeight  Int      @default(4)
  season      String?
  region      String?
  theme       String?
  isPublic    Boolean  @default(false)
  imageUrl    String?

  plants      GardenPlanPlant[]
  gardens     Garden[]

  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([difficulty])
  @@index([season])
  @@index([isPublic])
}

model GardenPlanPlant {
  id          String   @id @default(uuid()) @db.Uuid
  plotX       Int
  plotY       Int
  quantity    Int      @default(1)

  planId      String   @db.Uuid
  plan        GardenPlan @relation(fields: [planId], references: [id])

  speciesId   String   @db.Uuid
  species     PlantSpecies @relation(fields: [speciesId], references: [id])

  @@unique([planId, plotX, plotY])
  @@index([planId])
  @@index([speciesId])
}

model Garden {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @default("My Garden")
  type             GardenType @default(VIRTUAL)
  description      String?
  size             Int        @default(0)
  soilQuality      Float      @default(50.0)
  irrigationLevel  Float      @default(50.0)
  sunlightExposure Float      @default(50.0)

  gridWidth        Int        @default(6)
  gridHeight       Int        @default(6)
  irrigationType   String     @default("DRIP")
  wateringMode     String     @default("MANUAL")
  hasMotorPump     Boolean    @default(false)

  plotNumber       Int        @default(1)
  isPurchased      Boolean    @default(false)
  purchasedAt      DateTime?
  purchasePrice    Float      @default(0)
  soilLastCheckedAt DateTime?
  soilQualityHistory Json?
  plantMoveCount   Int        @default(0)

  latitude         Float?
  longitude        Float?
  address          String?
  timezone         String?

  theme            String?
  decorations      Json?
  planId           String?    @db.Uuid
  plan             GardenPlan? @relation(fields: [planId], references: [id])

  userId           String     @db.Uuid
  user             User       @relation("UserGardens", fields: [userId], references: [id])

  crops            Crop[]
  inventoryItems   UserInventory[]
  plotPurchases    PlotPurchase[]
  soilChecks       SoilCheck[]
  visits           GardenVisit[]
  userDecorations  UserGardenDecoration[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
  @@index([plotNumber, userId])
}

model Crop {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  species           String?
  variety           String?

  status            CropStatus @default(SEED)
  growthStage       Int        @default(0)
  health            Float      @default(100.0)
  hydration         Float      @default(50.0)
  nutrientLevel     Float      @default(50.0)

  plantedAt         DateTime   @default(now())
  lastWateredAt     DateTime?
  lastFertilizedAt  DateTime?
  estimatedHarvest  DateTime?
  harvestedAt       DateTime?

  plotX             Int?
  plotY             Int?

  careStreak        Int        @default(0)
  totalCareCount    Int        @default(0)

  weatherStressed   Boolean    @default(false)
  stressFactor      Float      @default(0.0)

  speciesId         String?    @db.Uuid
  plantSpecies      PlantSpecies? @relation(fields: [speciesId], references: [id])
  varietyId         String?    @db.Uuid
  cropVariety       CropVariety? @relation(fields: [varietyId], references: [id])

  gardenId          String     @db.Uuid
  garden            Garden     @relation(fields: [gardenId], references: [id])

  userId            String     @db.Uuid
  user              User       @relation(fields: [userId], references: [id])

  diseaseCases      DiseaseCase[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([gardenId])
  @@index([userId])
  @@index([status])
  @@index([speciesId])
}

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  itemType  String
  itemId    String
  name      String
  quantity  Int      @default(1)
  rarity    String   @default("COMMON")

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([itemType])
}

model MarketplaceListing {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  description String?
  category    String
  price       Float
  currency    String         @default("GREEN_CREDITS")
  quantity    Int            @default(1)
  status      ListingStatus  @default(ACTIVE)
  images      Json?
  location    String?
  isLocal     Boolean        @default(false)

  sellerId    String         @db.Uuid
  seller      User           @relation(fields: [sellerId], references: [id])

  transactions MarketplaceTransaction[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  expiresAt   DateTime?

  @@index([sellerId])
  @@index([category])
  @@index([status])
}

model MarketplaceTransaction {
  id              String            @id @default(uuid()) @db.Uuid
  status          TransactionStatus @default(PENDING)
  amount          Float
  currency        String            @default("GREEN_CREDITS")

  listingId       String            @db.Uuid
  listing         MarketplaceListing @relation(fields: [listingId], references: [id])

  buyerId         String            @db.Uuid
  buyer           User              @relation("BuyerTransactions", fields: [buyerId], references: [id])

  sellerId        String            @db.Uuid
  seller          User              @relation("SellerTransactions", fields: [sellerId], references: [id])

  blockchainTxId  String?

  createdAt       DateTime          @default(now())
  completedAt     DateTime?

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
}

model IotDevice {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  deviceType      String
  firmwareVersion String?
  isOnline        Boolean         @default(false)
  lastSeenAt      DateTime?
  publicKey       String?

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id])

  sensorReadings  SensorReading[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

model SensorReading {
  id         String     @id @default(uuid()) @db.Uuid
  sensorType SensorType
  value      Float
  unit       String
  isVerified Boolean    @default(false)

  deviceId   String     @db.Uuid
  device     IotDevice  @relation(fields: [deviceId], references: [id])

  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id])

  timestamp  DateTime   @default(now())

  @@index([deviceId])
  @@index([userId])
  @@index([timestamp])
  @@index([sensorType])
}

model WeatherRecord {
  id            String   @id @default(uuid()) @db.Uuid
  region        String
  temperature   Float
  humidity      Float
  rainfall      Float
  windSpeed     Float
  sunlightHours Float
  condition     String

  forecast      Json?
  alerts        Json?

  recordedAt    DateTime @default(now())
  expiresAt     DateTime?

  @@index([region])
  @@index([recordedAt])
  @@index([condition])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  isPush    Boolean  @default(true)

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
}

model SupportTicket {
  id            String    @id @default(uuid()) @db.Uuid
  subject       String
  message       String    @db.Text
  status        String    @default("OPEN")
  priority      String    @default("MEDIUM")

  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id])

  assignedToId  String?   @db.Uuid
  assignedTo    User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])

  adminNotes    String?   @db.Text
  closedAt      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@index([priority])
}

model AiScan {
  id               String   @id @default(uuid()) @db.Uuid
  imageUrl         String
  plantName        String?
  species          String?
  healthScore      Float?
  diseases         Json?
  recommendations  Json?

  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id])

  createdAt        DateTime @default(now())

  @@index([userId])
}

model GovernmentAdvisory {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  type        String
  region      String
  source      String
  url         String?
  data        Json?

  publishedAt DateTime
  expiresAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([region])
  @@index([type])
  @@index([publishedAt])
}

model Message {
  id          String   @id @default(uuid()) @db.Uuid
  content     String   @db.Text
  isEncrypted Boolean  @default(true)
  nonce       String?

  senderId    String   @db.Uuid
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])

  receiverId  String?  @db.Uuid
  receiver    User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])

  groupId     String?  @db.Uuid
  group       Group?   @relation(fields: [groupId], references: [id])

  createdAt   DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([groupId])
}

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  type        String
  region      String?
  isPrivate   Boolean       @default(false)
  iconUrl     String?

  members     GroupMember[]
  messages    Message[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([region])
  @@index([type])
}

model GroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  role      String   @default("MEMBER")

  groupId   String   @db.Uuid
  group     Group    @relation(fields: [groupId], references: [id])

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])

  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}

model Invite {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique
  type         InviteType @default(CODE)
  passcode     String?
  maxUses      Int        @default(1)
  useCount     Int        @default(0)
  isActive     Boolean    @default(true)
  expiresAt    DateTime?

  createdById  String    @db.Uuid
  createdBy    User      @relation("CreatedInvites", fields: [createdById], references: [id])

  redeemedById String?   @db.Uuid
  redeemedBy   User?     @relation("RedeemedInvites", fields: [redeemedById], references: [id])

  createdAt    DateTime  @default(now())
  redeemedAt   DateTime?

  @@index([code])
  @@index([createdById])
}

model TokenTransaction {
  id              String    @id @default(uuid()) @db.Uuid
  type            TokenType
  amount          Float
  balanceBefore   Float
  balanceAfter    Float
  action          String
  referenceId     String?
  referenceType   String?
  description     String?
  metadata        Json?

  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([action])
  @@index([createdAt])
}

model AppLog {
  id          String   @id @default(uuid()) @db.Uuid
  level       LogLevel @default(INFO)
  message     String
  context     String?
  metadata    Json?
  ipAddress   String?
  traceId     String?
  spanId      String?
  source      String   @default("backend")

  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
  @@index([traceId])
}

model QrSession {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  signature   String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)

  createdById String   @db.Uuid
  createdBy   User     @relation("CreatedQrSessions", fields: [createdById], references: [id])

  usedById    String?  @db.Uuid
  usedBy      User?    @relation("UsedQrSessions", fields: [usedById], references: [id])

  createdAt   DateTime @default(now())

  @@index([type])
  @@index([expiresAt])
}

model BlockchainTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  txHash       String?  @unique
  contractType String
  action       String
  fromAddress  String?
  toAddress    String?
  amount       String?
  tokenId      String?
  status       String   @default("PENDING")
  gasUsed      String?
  blockNumber  Int?

  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
  confirmedAt  DateTime?

  @@index([userId])
  @@index([txHash])
  @@index([status])
}

model ReputationLog {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  scoreChange Float
  reason      String

  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model ModerationReport {
  id           String   @id @default(uuid()) @db.Uuid
  type         String
  description  String?
  status       String   @default("PENDING")
  evidence     Json?

  reporterId   String   @db.Uuid
  reporter     User     @relation("ReportedReports", fields: [reporterId], references: [id])

  actionedById String?  @db.Uuid
  actionedBy   User?    @relation("ActionedReports", fields: [actionedById], references: [id])

  actionTaken  String?

  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([status])
  @@index([reporterId])
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  rules       Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model UserFeatureOverride {
  id          String   @id @default(uuid()) @db.Uuid
  featureName String
  enabled     Boolean

  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([userId, featureName])
}

model UserEnergy {
  id              String   @id @default(uuid()) @db.Uuid
  current         Int      @default(100)
  max             Int      @default(100)
  lastRegenAt     DateTime @default(now())
  regenRate       Int      @default(5)

  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model DailyReward {
  id              String   @id @default(uuid()) @db.Uuid
  day             Int
  claimedAt       DateTime @default(now())

  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, day])
  @@index([userId])
}

model PlantCollection {
  id              String   @id @default(uuid()) @db.Uuid
  discoveredAt    DateTime @default(now())
  timesPlanted    Int      @default(0)
  timesHarvested  Int      @default(0)

  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])

  speciesId       String   @db.Uuid
  species         PlantSpecies @relation(fields: [speciesId], references: [id])

  @@unique([userId, speciesId])
  @@index([userId])
  @@index([speciesId])
}

model SpeciesMastery {
  id              String    @id @default(uuid()) @db.Uuid
  level           Int       @default(1)
  experience      Int       @default(0)
  plantCount      Int       @default(0)
  harvestCount    Int       @default(0)
  perfectedAt     DateTime?

  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])

  speciesId       String    @db.Uuid
  species         PlantSpecies @relation(fields: [speciesId], references: [id])

  @@unique([userId, speciesId])
  @@index([userId])
  @@index([speciesId])
}

model PlantHybrid {
  id              String   @id @default(uuid()) @db.Uuid
  discoveredAt    DateTime @default(now())

  parent1Id       String   @db.Uuid
  parent1         PlantSpecies @relation("HybridParent1", fields: [parent1Id], references: [id])

  parent2Id       String   @db.Uuid
  parent2         PlantSpecies @relation("HybridParent2", fields: [parent2Id], references: [id])

  resultSpeciesId String   @db.Uuid
  resultSpecies   PlantSpecies @relation("HybridResult", fields: [resultSpeciesId], references: [id])

  discoveredById  String   @db.Uuid
  discoveredBy    User     @relation("HybridDiscoverer", fields: [discoveredById], references: [id])

  @@unique([parent1Id, parent2Id])
  @@index([resultSpeciesId])
}

model Achievement {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  name            String
  description     String?
  icon            String?
  category        String   @default("GENERAL")
  maxProgress     Int      @default(1)
  xpReward        Int      @default(0)
  tokenReward     Float    @default(0)

  userProgress    UserAchievement[]

  createdAt       DateTime @default(now())
}

model UserAchievement {
  id              String    @id @default(uuid()) @db.Uuid
  progress        Int       @default(0)
  completedAt     DateTime?

  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])

  achievementId   String    @db.Uuid
  achievement     Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

model ShopItem {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  category        String     @default("SEED")
  price           Float
  currency        String     @default("GREEN_CREDITS")
  icon            String?
  isLimited       Boolean    @default(false)
  stock           Int?
  levelRequired   Int        @default(1)

  itemType        String     @default("CONSUMABLE")
  effect          Json?
  isOnSale        Boolean    @default(false)
  discountPrice   Float?
  saleEndsAt      DateTime?

  purchases       UserPurchase[]
  inventoryItems  UserInventory[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([category])
  @@index([levelRequired])
  @@index([isOnSale])
}

model UserPurchase {
  id              String   @id @default(uuid()) @db.Uuid
  quantity        Int      @default(1)
  totalPrice      Float
  purchasedAt     DateTime @default(now())

  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])

  itemId          String   @db.Uuid
  item            ShopItem @relation(fields: [itemId], references: [id])

  @@index([userId])
  @@index([itemId])
}

model UserInventory {
  id          String   @id @default(uuid()) @db.Uuid
  isActive    Boolean  @default(true)
  purchasedAt DateTime @default(now())
  expiresAt   DateTime?

  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])

  itemId      String   @db.Uuid
  item        ShopItem @relation(fields: [itemId], references: [id])

  gardenId    String?  @db.Uuid
  garden      Garden?  @relation(fields: [gardenId], references: [id])

  @@index([userId])
  @@index([itemId])
  @@index([gardenId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?
  userAgent String?

  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  token        String   @unique
  refreshToken String?
  isRevoked    Boolean  @default(false)
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime

  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  type              String
  status            String           @default("draft")
  startDate         DateTime
  endDate           DateTime
  participants      Int              @default(0)
  rewards           String?
  schedule          String           @default("one-time")
  description       String?

  discountPercent   Float?
  minLevel          Int?
  maxRedemptions    Int?
  targetUserRole    String?
  targetGardenType  String?
  couponCode        String?

  rewardsConfig     CampaignReward[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([type])
}

model CampaignReward {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  type       String   @default("item")
  value      String
  rarity     String   @default("common")
  cost       Float    @default(0)

  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

// --- Coupon System ---------------------------------------------------------

model Coupon {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  description     String?
  discountType    String    @default("PERCENTAGE")
  discountValue   Float
  minPurchase     Float     @default(0)
  maxRedemptions  Int?
  usedCount       Int       @default(0)
  minLevel        Int       @default(1)
  appliesTo       String?
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

// --- Fertilizer Catalog ----------------------------------------------------

model Fertilizer {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  category        String    @default("ORGANIC")
  effect          Json      @default("{\"growthBoost\":1.5,\"healthBonus\":10,\"hydrationBonus\":5,\"durationHours\":24}")
  price           Float
  currency        String    @default("GREEN_CREDITS")
  icon            String?
  rarity          String    @default("COMMON")
  levelRequired   Int       @default(1)
  isActive        Boolean   @default(true)
  stock           Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([rarity])
}

// --- Plot Purchases ---------------------------------------------------------

model PlotPurchase {
  id              String    @id @default(uuid()) @db.Uuid
  price           Float
  tokenType       String    @default("GREEN_CREDITS")
  plotNumber      Int
  purchasedAt     DateTime  @default(now())

  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])

  gardenId        String    @db.Uuid
  garden          Garden    @relation(fields: [gardenId], references: [id])

  @@index([userId])
  @@index([gardenId])
}

// --- Soil Check Records ----------------------------------------------------

model SoilCheck {
  id              String    @id @default(uuid()) @db.Uuid
  phLevel         Float?
  moisture        Float?
  nitrogen        Float?
  phosphorus      Float?
  potassium       Float?
  organicMatter   Float?
  quality         Float
  notes           String?
  checkedAt       DateTime  @default(now())

  gardenId        String    @db.Uuid
  garden          Garden    @relation(fields: [gardenId], references: [id])

  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])

  @@index([gardenId])
  @@index([checkedAt])
}

// --- External Data Sync Log -------------------------------------------------

model ExternalDataSync {
  id              String    @id @default(uuid()) @db.Uuid
  source          String
  status          String    @default("PENDING")
  recordsFetched  Int       @default(0)
  recordsUpdated  Int       @default(0)
  message         String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([source])
  @@index([startedAt])
}

// --- Quest System ----------------------------------------------------------

model Quest {
  id              String        @id @default(uuid()) @db.Uuid
  key             String        @unique
  title           String
  description     String
  category        String        @default("DAILY")
  type            String        @default("PLANT")
  targetCount     Int           @default(1)
  xpReward        Int           @default(0)
  creditReward    Float         @default(0)
  itemReward      String?
  icon            String?
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  seasonId        String?       @db.Uuid
  season          SeasonEvent?  @relation(fields: [seasonId], references: [id])
  userProgress    UserQuest[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([category])
  @@index([isActive])
  @@index([seasonId])
}

model UserQuest {
  id              String    @id @default(uuid()) @db.Uuid
  progress        Int       @default(0)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  claimedAt       DateTime?
  questKey        String
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id])
  questId         String    @db.Uuid
  quest           Quest     @relation(fields: [questId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@unique([userId, questId])
  @@index([userId])
  @@index([isCompleted])
}

// --- Social: Friends -------------------------------------------------------

model Friend {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation("UserFriends", fields: [userId], references: [id])
  friendId        String   @db.Uuid
  friend          User     @relation("FriendOf", fields: [friendId], references: [id])
  createdAt       DateTime @default(now())
  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model FriendRequest {
  id              String   @id @default(uuid()) @db.Uuid
  status          String   @default("PENDING")
  fromUserId      String   @db.Uuid
  fromUser        User     @relation("SentRequests", fields: [fromUserId], references: [id])
  toUserId        String   @db.Uuid
  toUser          User     @relation("ReceivedRequests", fields: [toUserId], references: [id])
  createdAt       DateTime @default(now())
  respondedAt     DateTime?
  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([status])
}

// --- Garden Visits ----------------------------------------------------------

model GardenVisit {
  id              String   @id @default(uuid()) @db.Uuid
  rating          Int?
  comment         String?
  visitorId       String   @db.Uuid
  visitor         User     @relation("VisitsMade", fields: [visitorId], references: [id])
  gardenId        String   @db.Uuid
  garden          Garden   @relation(fields: [gardenId], references: [id])
  visitedAt       DateTime @default(now())
  @@index([gardenId])
  @@index([visitorId])
}

// --- Gifting ---------------------------------------------------------------

model Gift {
  id              String   @id @default(uuid()) @db.Uuid
  itemType        String
  itemName        String
  quantity        Int      @default(1)
  message         String?
  isOpened        Boolean  @default(false)
  fromUserId      String   @db.Uuid
  fromUser        User     @relation("GiftsSent", fields: [fromUserId], references: [id])
  toUserId        String   @db.Uuid
  toUser          User     @relation("GiftsReceived", fields: [toUserId], references: [id])
  createdAt       DateTime @default(now())
  openedAt        DateTime?
  @@index([toUserId])
  @@index([fromUserId])
}

// --- Streak Shields ---------------------------------------------------------

model StreakShield {
  id              String   @id @default(uuid()) @db.Uuid
  isActive        Boolean  @default(true)
  reason          String?
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  usedAt          DateTime?
  @@index([userId])
}

// --- Notification Preferences -----------------------------------------------

model NotificationPreferences {
  id                    String  @id @default(uuid()) @db.Uuid
  growthAlerts          Boolean @default(true)
  waterReminders        Boolean @default(true)
  weatherAlerts         Boolean @default(true)
  socialNotifications   Boolean @default(true)
  marketplaceUpdates    Boolean @default(true)
  achievementUnlocks    Boolean @default(true)
  streakReminders       Boolean @default(true)
  eventNotifications    Boolean @default(true)
  quietHoursStart       String?
  quietHoursEnd         String?
  quietHoursEnabled     Boolean @default(false)
  userId                String  @unique @db.Uuid
  user                  User    @relation(fields: [userId], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// --- Seasonal Events --------------------------------------------------------

model SeasonEvent {
  id              String        @id @default(uuid()) @db.Uuid
  key             String        @unique
  name            String
  description     String?
  type            String        @default("SEASONAL")
  status          String        @default("DRAFT")
  startDate       DateTime
  endDate         DateTime
  icon            String?
  bannerUrl       String?
  themeColor      String?
  quests          Quest[]
  shopItems       EventShopItem[]
  userProgress    UserEventProgress[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([status])
  @@index([startDate, endDate])
}

model EventShopItem {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  price           Float
  currency        String      @default("GREEN_CREDITS")
  icon            String?
  stock           Int?
  isLimited       Boolean     @default(true)
  seasonEventId   String      @db.Uuid
  seasonEvent     SeasonEvent @relation(fields: [seasonEventId], references: [id])
  createdAt       DateTime    @default(now())
  @@index([seasonEventId])
}

model UserEventProgress {
  id              String      @id @default(uuid()) @db.Uuid
  points          Int         @default(0)
  tier            Int         @default(1)
  rewardsClaimed  Json?
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id])
  seasonEventId   String      @db.Uuid
  seasonEvent     SeasonEvent @relation(fields: [seasonEventId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@unique([userId, seasonEventId])
  @@index([userId])
}

// --- Breeding Lab -----------------------------------------------------------

model BreedingLab {
  id              String   @id @default(uuid()) @db.Uuid
  status          String   @default("BREEDING")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  resultSpeciesId String?  @db.Uuid
  resultSpecies   PlantSpecies? @relation("BreedResult", fields: [resultSpeciesId], references: [id])
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  parent1Id       String   @db.Uuid
  parent1         PlantSpecies @relation("BreedParent1", fields: [parent1Id], references: [id])
  parent2Id       String   @db.Uuid
  parent2         PlantSpecies @relation("BreedParent2", fields: [parent2Id], references: [id])
  @@index([userId])
  @@index([status])
}

// --- Disease & Treatment ----------------------------------------------------

model DiseaseCase {
  id              String   @id @default(uuid()) @db.Uuid
  diseaseType     String
  severity        Int      @default(1)
  status          String   @default("ACTIVE")
  startedAt       DateTime @default(now())
  treatedAt       DateTime?
  resolvedAt      DateTime?
  cropId          String   @db.Uuid
  crop            Crop     @relation(fields: [cropId], references: [id])
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  @@index([cropId])
  @@index([userId])
  @@index([status])
}

model Treatment {
  id              String   @id @default(uuid()) @db.Uuid
  treatmentType   String
  name            String
  cost            Float    @default(0)
  effectiveness   Int      @default(80)
  durationHours   Int      @default(24)
  createdAt       DateTime @default(now())
}

// --- Garden Themes & Decorations --------------------------------------------

model GardenTheme {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  name            String
  description     String?
  icon            String?
  price           Float    @default(0)
  currency        String   @default("GREEN_CREDITS")
  isDefault       Boolean  @default(false)
  soilColor       String?
  grassColor      String?
  decorStyle      String?
  createdAt       DateTime @default(now())
}

model UserGardenDecoration {
  id              String   @id @default(uuid()) @db.Uuid
  decorationType  String
  name            String
  position        Json?
  isActive        Boolean  @default(true)
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  gardenId        String   @db.Uuid
  garden          Garden   @relation(fields: [gardenId], references: [id])
  createdAt       DateTime @default(now())
  @@index([userId])
  @@index([gardenId])
}

// --- Referral System --------------------------------------------------------

model Referral {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  status          String   @default("PENDING")
  referrerId      String   @db.Uuid
  referrer        User     @relation("ReferralsMade", fields: [referrerId], references: [id])
  refereeId       String?  @unique @db.Uuid
  referee         User?    @relation("ReferralReceived", fields: [refereeId], references: [id])
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  @@index([code])
  @@index([referrerId])
}
