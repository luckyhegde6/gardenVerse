FROM node:22-alpine AS builder

WORKDIR /app

COPY ../../package.json ../../package-lock.json* /app/
COPY packages/backend/package.json /app/packages/backend/
COPY packages/backend/tsconfig.json /app/packages/backend/
COPY packages/backend/nest-cli.json /app/packages/backend/
COPY packages/backend/prisma /app/packages/backend/prisma

WORKDIR /app/packages/backend
RUN npm ci
RUN npx prisma generate

COPY packages/backend/src /app/packages/backend/src
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache tini

COPY --from=builder /app/packages/backend/dist ./dist
COPY --from=builder /app/packages/backend/prisma ./prisma
COPY --from=builder /app/packages/backend/node_modules ./node_modules
COPY packages/backend/package.json ./

EXPOSE 3001

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main"]
