# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gardenverse?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# Blockchain
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=

# Telegram
TELEGRAM_BOT_TOKEN=

# Weather (OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Google Maps
GOOGLE_MAPS_API_KEY=

# Plant Data APIs
TREFLE_API_KEY=
OPENFARM_API_URL=https://openfarm.cc/api/v1

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# FCM
FCM_SERVER_KEY=

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=GardenVerse API
SWAGGER_DESCRIPTION=GardenVerse Social Gardening Platform API
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# Email Verification (set to true when SMTP/email service is configured)
REQUIRE_EMAIL_VERIFICATION=false

# Super Admin
SUPER_ADMIN_REGISTRATION_CODE=change-this-in-production-to-random-uuid
ADMIN_COOKIE_DOMAIN=localhost
ADMIN_COOKIE_SECURE=false
