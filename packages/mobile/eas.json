{
  "cli": {
    "version": ">= 8.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "API_URL": "http://localhost:3000/api/v1",
        "WS_URL": "ws://localhost:3001"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://gardenverse.vercel.app/api/v1",
        "WS_URL": "wss://ws.gardenverse.app"
      },
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "API_URL": "https://gardenverse.vercel.app/api/v1",
        "WS_URL": "wss://ws.gardenverse.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "@my-apple-id",
        "ascAppId": "@my-asc-app-id",
        "appleTeamId": "@my-apple-team-id"
      }
    }
  }
}
