{
  "cli": {
    "version": ">= 8.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "API_URL": "http://10.0.2.2:3000/api/v1",
        "WS_URL": "ws://10.0.2.2:3001"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://gardenverse.vercel.app/api/v1",
        "WS_URL": "wss://ws.gardenverse.app",
        "GRADLE_DISTRIBUTION_URL": "https://services.gradle.org/distributions/gradle-8.5-all.zip"
      }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://gardenverse.vercel.app/api/v1",
        "WS_URL": "wss://ws.gardenverse.app",
        "GRADLE_DISTRIBUTION_URL": "https://services.gradle.org/distributions/gradle-8.5-all.zip"
      }
    }
  },
  "submit": {}
}
