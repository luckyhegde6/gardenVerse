# ===========================================================================
# GardenVerse - Production Environment Template
# Copy to .env.production and fill in values from Vercel dashboard
# NEVER commit .env.production to git!
# ===========================================================================

NODE_ENV=production
PORT=3000

# Supabase Database (get from Supabase dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Redis (Upstash for Vercel serverless)
REDIS_URL=redis://your-upstash-url:6379

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Services
AI_SERVICE_URL=http://localhost:8000

# Feature Flags
FEATURE_AI_DIAGNOSIS=true
FEATURE_MARKETPLACE=true
FEATURE_IOT_BETA=false
FEATURE_BLOCKCHAIN_BETA=false
FEATURE_REGIONAL_FEED=true
